{
  "name": "contract-one",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write src tools tests",
    "format:check": "prettier --check src tools tests",
    "sim": "tsx tools/sim.ts",
    "smoke": "tsx tools/smoke.ts",
    "shots:build": "vite build --config vite.shots.config.ts",
    "shots": "tsx tools/shots/capture.ts",
    "bench": "tsx tools/bench.ts"
  },
  "dependencies": {
    "pixi.js": "^8.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.19.43",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "puppeteer-core": "^25.16.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.71.2",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
